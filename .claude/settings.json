{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*credentials*.json)",
      "Read(./**/secrets/**)",
      "Read(./.claude/settings.local.json)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run dev)"
    ]
  }
}
